{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile && cd web/dashboard && pnpm install --frozen-lockfile",
  "buildCommand": "cd web/dashboard && pnpm build",
  "outputDirectory": "web/dashboard/dist/public",
  "rewrites": [
    { "source": "/audit/:id", "destination": "/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
